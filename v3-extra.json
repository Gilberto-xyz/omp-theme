{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "background": "#00D084",
          "foreground": "#EAF7F2",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " <#003543> \ue795 </> <#D000FF>Shell</> "
        },
        {
          "type": "os",
          "style": "powerline",
          "background": "#0F0F0F",
          "foreground": "#FF9D00",
          "powerline_symbol": "\ue0b0",
          "template": " {{ .Icon }} {{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "background": "#141414",
          "foreground": "#FFE066",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_icon": "",
            "folder_separator_icon": "\\",
            "home_icon": "~",
            "style": "full"
          },
          "template": " \uf115 {{ .Path }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "background": "#1A1A1A",
          "foreground": "#FF9D00",
          "powerline_symbol": "\ue0b0",
          "options": {
            "always_enabled": true,
            "threshold": 0
          },
          "template": " \ueba2 {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "powerline",
          "background": "#0D0D0D",
          "foreground": "#FFD24A",
          "powerline_symbol": "\ue0b0",
          "options": {
            "time_format": "3:04 PM"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        },
        {
          "background": "#5B4B8A",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9F1C{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FF4D8D{{ end }}",
            "{{ if and (gt .Ahead 0) (eq .Behind 0) }}#00D084{{ end }}",
            "{{ if and (gt .Behind 0) (eq .Ahead 0) }}#4CC9F0{{ end }}",
            "{{ if and (gt .StashCount 0) (not .Working.Changed) (not .Staging.Changed) (eq .Ahead 0) (eq .Behind 0) }}#B07CFF{{ end }}"
          ],
          "foreground": "#FFFFFF",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#111111{{ end }}",
            "{{ if and (gt .Ahead 0) (eq .Behind 0) }}#06261D{{ end }}",
            "{{ if and (gt .Behind 0) (eq .Ahead 0) }}#06202A{{ end }}",
            "{{ if and (gt .StashCount 0) (not .Working.Changed) (not .Staging.Changed) (eq .Ahead 0) (eq .Behind 0) }}#111111{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}
